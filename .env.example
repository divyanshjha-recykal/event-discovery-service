# Opportunity Radar — environment. Copy to `.env` and fill in.
# `.env` is gitignored and is never committed. Nothing here has a real value;
# every line below is either a name to fill in or a local-only default.

# ---------------------------------------------------------------------------
# OpenRouter — the reasoning model. Read from the environment, never hardcoded.
# ---------------------------------------------------------------------------
# From https://openrouter.ai/keys
OPENROUTER_API_KEY=
# A model slug as OpenRouter spells it, e.g. "<vendor>/<model>". No default is
# baked in anywhere in the code; this variable is the only place it is set.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Discovery tools (Stage 3). Named now so config is complete; unused until then.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# MongoDB — must match the `mongodb` service in docker-compose.yml.
# Local-only container credentials; change them if you like, but keep the URI
# in step with the username/password below.
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=radar
MONGO_ROOT_PASSWORD=radar
MONGO_DB_NAME=opportunity_radar
MONGO_URI=mongodb://radar:radar@localhost:27017/?authSource=admin

# ---------------------------------------------------------------------------
# Langfuse — tracing. Required from Stage 0; the pipeline should not run
# untraced. http://localhost:3000
# ---------------------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
# Self-hosted, so you choose these yourself rather than being issued them.
# They must start with the prefixes shown. Compose passes them to
# LANGFUSE_INIT_PROJECT_* so the project exists with these keys on first boot.
# Generate: openssl rand -hex 16   ->   pk-lf-<hex> / sk-lf-<hex>
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-

# First-boot provisioning for the Langfuse UI login. Only read on the very first
# start against an empty Postgres volume.
LANGFUSE_INIT_ORG_ID=recykal
LANGFUSE_INIT_ORG_NAME=Recykal
LANGFUSE_INIT_PROJECT_ID=opportunity-radar
LANGFUSE_INIT_PROJECT_NAME=Opportunity Radar
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Langfuse backing services. Local-only defaults; safe as-is for a laptop stack,
# not safe for anything exposed. Compose falls back to these if unset.
# ---------------------------------------------------------------------------
# Required — compose refuses to start if any of these three is unset. Do NOT ship
# the values from an example file; generate your own, and get ENCRYPTION_KEY right
# before first boot (Langfuse cannot decrypt old data if you change it later).
#   ENCRYPTION_KEY:   openssl rand -hex 32
#   NEXTAUTH_SECRET:  openssl rand -hex 32
#   SALT:             openssl rand -hex 16
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
SALT=
POSTGRES_PASSWORD=postgres
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_PASSWORD=miniosecret
REDIS_AUTH=myredissecret

# ---------------------------------------------------------------------------
# Business profile. Optional; defaults to BusinessProfile.md at the repo root.
# ---------------------------------------------------------------------------
# BUSINESS_PROFILE_PATH=BusinessProfile.md

---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	search(search)
	rank(rank)
	fetch(fetch)
	extract(extract)
	evaluate(evaluate)
	store(store)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	evaluate -.-> plan;
	evaluate -.-> store;
	extract --> evaluate;
	fetch -.-> evaluate;
	fetch -.-> extract;
	plan --> search;
	rank -.-> evaluate;
	rank -.-> fetch;
	rank -.-> plan;
	search --> rank;
	store --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
